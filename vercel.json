{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm build:vercel",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "TENANT_API_URL" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/vercel-server.ts",
      "installCommand": "cd ../.. && corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm build:vercel:api",
      "functions": { "src/vercel-server.ts": { "maxDuration": 300, "regions": ["fra1"] } }
    },
    "worker": {
      "root": "apps/worker",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "cd ../.. && corepack pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && corepack pnpm db:generate && corepack pnpm --filter @pos/worker build",
      "functions": { "src/server.ts": { "maxDuration": 300, "regions": ["fra1"] } }
    }
  },
  "rewrites": [
    { "source": "/api/internal/jobs", "destination": { "service": "worker" } },
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/:path*", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/internal/jobs", "schedule": "0 2 * * *" }]
}
