# Proiect comun Vercel Services; copiați numai cheile tenant din fișierul privat generat.
NODE_ENV=production
TENANT_ORIGIN=https://POS_PROJECT.vercel.app
DATABASE_URL=postgresql://pos_runtime:REPLACE@DIRECT_HOST.neon.tech/pos?sslmode=require
AUTH_DATABASE_URL=postgresql://pos_auth:REPLACE@DIRECT_HOST.neon.tech/pos?sslmode=require
WORKER_DATABASE_URL=postgresql://pos_worker:REPLACE@DIRECT_HOST.neon.tech/pos?sslmode=require
MFA_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_HEX
CSRF_SECRET=GENERATE_48_RANDOM_BYTES_HEX
CRON_SECRET=GENERATE_32_RANDOM_BYTES_HEX
MEDIA_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=FROM_PRIVATE_BLOB_STORE
NEXT_TELEMETRY_DISABLED=1
ENABLE_EXPERIMENTAL_COREPACK=1
# TENANT_API_URL este injectat automat prin binding; nu setați aliasul public ca upstream.
