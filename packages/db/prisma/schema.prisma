  actorUserId String @db.Uuid
  requestKey String @db.Uuid
  status String
  requestHash String?
  expectedVersion Int?
  resultVersion Int? @default(dbgenerated())
  zoneId String? @db.Uuid
  zoneVersion Int?
  zoneCommandId String? @default(dbgenerated()) @db.Uuid
  destination Json?
  subtotal Decimal? @db.Decimal(18,2)
  fee Decimal? @db.Decimal(18,2)
  total Decimal? @db.Decimal(18,2)
  deliveryAddressHash String? @default(dbgenerated())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([organizationId,requestKey])
  @@unique([organizationId,locationId,orderId,id])
}

model DeliveryProof {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  locationId String @db.Uuid
  orderId String @db.Uuid
  operationId String @db.Uuid
  assignmentId String @db.Uuid
  actorUserId String @db.Uuid
  privateDataEncrypted String
  confirmedAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([organizationId,id])
  @@unique([organizationId,operationId])
  @@index([organizationId,locationId,orderId], map: "delivery_proof_order")
}
