{
  "name": "pos-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev:delivery-sandbox": "node --import tsx scripts/delivery-sandbox/start.ts",
    "dev:website": "node --import tsx scripts/delivery-sandbox/start.ts",
    "website:configure": "node --import tsx scripts/delivery-sandbox/configure.ts",
    "dev": "node --env-file=.env scripts/dev.mjs",
    "dev:worker": "node --env-file=.env --import tsx apps/worker/src/main.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "pnpm --filter @pos/db generate",
    "db:validate": "pnpm --filter @pos/db validate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "bootstrap": "node --env-file=.env --import tsx apps/api/src/bootstrap.ts",
    "seed": "node --env-file=.env --import tsx apps/api/src/seed.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint apps packages scripts tests --ignore-pattern '**/generated/**' && pnpm check:style",
    "check:style": "node scripts/code-style-check.mjs",
    "format": "prettier --write apps packages scripts tests *.json *.mjs *.ts docs AGENTS.md README.md",
    "format:check": "prettier --check apps packages scripts tests *.json *.mjs *.ts docs AGENTS.md README.md",
    "build": "pnpm -r --if-present build",
    "build:vercel": "pnpm preflight:vercel && pnpm --filter @pos/web build",
    "build:vercel:api": "pnpm db:generate && pnpm --filter @pos/api build",
    "preflight:vercel": "node --import tsx scripts/vercel-preflight.ts",
    "db:hosted:configure": "node --import tsx scripts/hosted-db/configure.ts",
    "preflight": "node scripts/preflight.mjs",
    "test:db": "node --env-file=.env --import tsx --test packages/db/test/*.test.ts",
    "test:worker": "node --env-file=.env --import tsx packages/db/test/jobs-worker-smoke.ts",
    "test:load": "node --env-file=.env --import tsx scripts/load-test.ts",
    "seed:pins": "node --env-file=.env --import tsx scripts/enable-demo-pins.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.0",
    "ws": "8.21.3"
  }
}
